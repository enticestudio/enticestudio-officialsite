# Copy this file to .env.local and fill in your values. Never commit .env.local.

# ── Email (Resend, https://resend.com) ──────────────────────────────
# API key from resend.com → API Keys. Server-only; never exposed to the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where quote requests are delivered. Comma-separate for several inboxes.
CONTACT_TO_EMAIL=you@example.com

# Sender address. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which can only deliver to the email on your Resend account and skips the client
# confirmation. After verifying your domain in Resend, set e.g.:
# CONTACT_FROM_EMAIL=Entice Studio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=

# ── WhatsApp ────────────────────────────────────────────────────────
# Your WhatsApp number in international format, digits only (no +, spaces or leading 0).
# Example: Sri Lankan 077 123 4567 → 94771234567
# Leave empty to hide every WhatsApp button. Rebuild after changing it.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Social media ────────────────────────────────────────────────────
# Full profile links. The @handle shown on the site is taken from the link.
# Leave any empty to hide it on the live site (npm run dev still shows a preview).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
# e.g. https://www.instagram.com/yourhandle
#      https://www.tiktok.com/@yourhandle
#      https://www.facebook.com/yourpage
